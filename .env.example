# Put real values in the Gateway profile state file, not in this repository.
# For --profile weather-agent on Windows, that is normally:
# C:\Users\<you>\.openclaw-weather-agent\.env

# OpenAI-compatible model provider. Store its API key in the file-backed
# SecretRef configured by config/openclaw.example.json5, not in this .env.
LLM_API_BASE_URL=https://replace-with-your-provider.example/v1

# Local Gateway authentication
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Weather sources
QWEATHER_API_HOST=abc1234xyz.def.qweatherapi.com
QWEATHER_API_KEY=replace-me

# Optional: only needed for Open-Meteo commercial/customer endpoints.
# OPEN_METEO_API_KEY=replace-me
# OPEN_METEO_FORECAST_HOST=https://customer-api.open-meteo.com
# OPEN_METEO_GEOCODING_HOST=https://customer-geocoding-api.open-meteo.com

# Public web search
TAVILY_API_KEY=replace-me

# Feishu weather application
FEISHU_WEATHER_APP_ID=replace-me
FEISHU_WEATHER_APP_SECRET=replace-me

# OpenClaw cron delivery. Keep the reviewed Feishu group ids in the profile
# .env; the first group receives native cron delivery and the remaining groups
# receive the same report through OpenClaw's native message tool. Without any
# target, scripts/setup-automations.ps1 declares jobs disabled.
# The national jobs treat WEATHER_SCHEDULE_LOCATION as a report scope, not as a
# location string to submit to a weather provider.
WEATHER_SCHEDULE_FEISHU_TARGETS=chat:replace-with-reviewed-group-1,chat:replace-with-reviewed-group-2
WEATHER_SCHEDULE_LOCATION=全国
