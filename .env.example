APP_ENV=production

# Weather providers
QWEATHER_API_KEY=
CAIYUN_API_KEY=

# OpenClaw explainer endpoint. Leave empty to use deterministic local explanation.
OPENCLAW_API_URL=
OPENCLAW_API_KEY=

# Feishu app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_CHAT_ID=

# Feishu bitable
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_TASK_BITABLE_TABLE_ID=

# Local fallback store
LOCAL_JSONL_PATH=data/weather_submissions.jsonl
LOCAL_TASK_JSONL_PATH=data/weather_tasks.jsonl

# Default scheduled task location. Leave latitude/longitude empty to resolve by region.
DEFAULT_WEATHER_REGION=广东省深圳市
DEFAULT_WEATHER_LATITUDE=
DEFAULT_WEATHER_LONGITUDE=
