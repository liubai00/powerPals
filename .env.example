APP_ENV=production

# Administrative write/publish APIs fail closed. Use a long random secret and
# send it as `Authorization: Bearer <token>`. External Feishu effects remain
# disabled unless explicitly enabled; DRY_RUN always overrides that enable.
ADMIN_API_TOKEN=
GLOBAL_FEISHU_SEND_ENABLED=false
DRY_RUN=false

# Weather providers. API credentials do not grant production data-use permission:
# the matching provider/endpoint must also pass WEATHER_SOURCE_POLICIES_JSON.
QWEATHER_API_KEY=
QWEATHER_API_HOST=
CAIYUN_API_KEY=

# OpenClaw explainer endpoint. Leave empty to use deterministic local explanation.
OPENCLAW_API_URL=
OPENCLAW_API_KEY=

# OpenAI-compatible LLM endpoint for explanations and general bot replies.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT=20
# Search is discovery-only: an API key must never make a snippet/model summary
# eligible as structured weather, load, generation, unit or price truth.
TAVILY_API_KEY=
FEISHU_PROGRESS_MESSAGE_ENABLED=false
# Local/test callback fixtures only. Production/staging ignore this bypass and
# require the matching FEISHU_*_VERIFICATION_TOKEN.
FEISHU_ALLOW_UNSIGNED_EVENTS=false
FEISHU_INTERNAL_TIMEOUT_SECONDS=600

# Legacy Feishu app. Keep this for one-bot compatibility, or leave empty when using role-specific bots below.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_CHAT_ID=
FEISHU_BOT_OPEN_ID=
# Unsafe compatibility only. Keep false in production; configured bot open_id is required for group mentions.
FEISHU_ALLOW_LEGACY_NAME_MENTIONS=false

# Feishu weather forecast bot. Configure its event callback to /feishu/events/weather.
FEISHU_WEATHER_APP_ID=
FEISHU_WEATHER_APP_SECRET=
FEISHU_WEATHER_VERIFICATION_TOKEN=
FEISHU_WEATHER_ENCRYPT_KEY=
FEISHU_WEATHER_DEFAULT_CHAT_ID=
FEISHU_WEATHER_BOT_OPEN_ID=

# Feishu weather task bot. Configure its event callback to /feishu/events/task.
FEISHU_TASK_APP_ID=
FEISHU_TASK_APP_SECRET=
FEISHU_TASK_VERIFICATION_TOKEN=
FEISHU_TASK_ENCRYPT_KEY=
FEISHU_TASK_DEFAULT_CHAT_ID=
FEISHU_TASK_BOT_OPEN_ID=

# Feishu bitable
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_TASK_BITABLE_TABLE_ID=

# Local fallback store
LOCAL_JSONL_PATH=data/weather_submissions.jsonl
LOCAL_TASK_JSONL_PATH=data/weather_tasks.jsonl
LOCAL_LOCATIONS_PATH=data/locations.json
LOCAL_NEWS_JSONL_PATH=data/news_items.jsonl
LOCAL_HYDROLOGY_JSONL_PATH=data/hydrology_records.jsonl
POWER_BRIEFING_CACHE_DB=data/power_briefing_cache.db
POWER_BRIEFING_CACHE_TTL_SECONDS=86400
# Keep the existing Beijing-time 09:00 job, but scheduled delivery needs all
# three gates: global send, this explicit opt-in, and a reviewed JSON target
# list. DRY_RUN=true is an unconditional no-send override.
POWER_BRIEFING_ALLOW_SEND=false
POWER_BRIEFING_TARGETS_JSON=[]
# Legacy 09:00 task / 16:30 reminder / 17:00 forecast rhythm. This is separate
# from the power briefing cron and must not inherit the global send opt-in.
LEGACY_WEATHER_SCHEDULER_ENABLED=false

# SourceRegistry + DataAvailabilityGate fail closed. Production must remain []
# until a human has reviewed the exact environment/provider/endpoint, terms or
# contract version, allowed use, attribution, retention, units, coverage,
# timezone, freshness and completeness. Raw third-party storage is unsupported.
WEATHER_SOURCE_POLICIES_JSON=[]

# Subscription and alert state contains authorization/audit only, never owned
# weather or power facts. Activation does not authorize delivery by itself;
# production notification delivery stays disabled until its source and target
# scopes are reviewed and all send gates are implemented and approved.
SUBSCRIPTIONS_DB=data/subscriptions.db
ALERTS_DB=data/alerts.db
ALERT_SEND_ENABLED=false
SUBSCRIPTION_ADMIN_OPEN_IDS_JSON=[]

# Controlled learning never sends Feishu messages or applies candidates automatically.
# Keep it disabled until its independent reference-data SourcePolicy is reviewed.
CONTROLLED_LEARNING_ENABLED=false
CONTROLLED_LEARNING_DB=data/controlled_learning.db
CONTROLLED_LEARNING_REPORT_DIR=data/controlled_learning/reports
CONTROLLED_LEARNING_TRUTH_DELAY_DAYS=1
CONTROLLED_LEARNING_MIN_PROVIDER_SAMPLES=5
CONTROLLED_LEARNING_ARCHIVE_API_URL=https://archive-api.open-meteo.com/v1/archive

# Public URL used in Feishu cards for web reports and downloads.
PUBLIC_BASE_URL=

# Default scheduled task location. Leave latitude/longitude empty to resolve by region.
DEFAULT_WEATHER_REGION=广东省深圳市
DEFAULT_WEATHER_LATITUDE=
DEFAULT_WEATHER_LONGITUDE=
