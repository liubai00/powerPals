# 电力气象消息（北京时间：09:00完整晨报；15:00仅在相较09:00有实质变化时发送）
SHELL=/bin/sh
CRON_TZ=Asia/Shanghai
WEATHER_AGENT_COMPOSE_DIR=/data/application/openclaw/powerPals
50 8 * * * cd "$WEATHER_AGENT_COMPOSE_DIR" && docker compose exec -T -e POWER_BRIEFING_MODE=precompute weather-bot python -m scripts.daily_power_briefing >> /var/log/power_briefing-precompute.log 2>&1
0 9 * * * cd "$WEATHER_AGENT_COMPOSE_DIR" && docker compose exec -T -e POWER_BRIEFING_MODE=send weather-bot python -m scripts.daily_power_briefing >> /var/log/power_briefing.log 2>&1
50 14 * * * cd "$WEATHER_AGENT_COMPOSE_DIR" && docker compose exec -T -e POWER_BRIEFING_MODE=afternoon_precompute weather-bot python -m scripts.daily_power_briefing >> /var/log/power_briefing-afternoon-precompute.log 2>&1
0 15 * * * cd "$WEATHER_AGENT_COMPOSE_DIR" && docker compose exec -T -e POWER_BRIEFING_MODE=afternoon_send weather-bot python -m scripts.daily_power_briefing >> /var/log/power_briefing-afternoon.log 2>&1
