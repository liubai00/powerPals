{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerpals.dev/schemas/weather_submission_v1.schema.json",
  "title": "PowerPals Weather Submission v1",
  "type": "object",
  "required": [
    "submission_type",
    "task_id",
    "track",
    "bot",
    "scope",
    "time_info",
    "data_profile",
    "payload",
    "confidence",
    "explanation",
    "scoring_profile",
    "region",
    "target_date",
    "data_cutoff_time",
    "provider_results",
    "aggregated_forecast",
    "key_factors",
    "risk_notes",
    "disclaimer"
  ],
  "properties": {
    "submission_type": { "const": "official_submission" },
    "task_id": { "type": "string", "pattern": "^WEATHER-CN-[A-Z0-9_\\-]+-[0-9]{8}-DAYAHEAD-[0-9]{3}$" },
    "track": { "const": "weather_forecast" },
    "bot": { "$ref": "#/$defs/bot" },
    "scope": { "$ref": "#/$defs/scope" },
    "time_info": { "$ref": "#/$defs/time_info" },
    "data_profile": { "$ref": "#/$defs/data_profile" },
    "payload": { "$ref": "#/$defs/payload" },
    "confidence": {
      "type": "object",
      "required": ["score", "description"],
      "properties": {
        "score": { "type": "number" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "explanation": { "$ref": "#/$defs/explanation" },
    "scoring_profile": { "$ref": "#/$defs/scoring_profile" },
    "region": { "type": "string" },
    "target_date": { "type": "string", "format": "date" },
    "data_cutoff_time": { "type": "string" },
    "provider_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider_forecast" }
    },
    "aggregated_forecast": { "$ref": "#/$defs/aggregated_forecast" },
    "key_factors": { "type": "array", "items": { "type": "string" } },
    "risk_notes": { "type": "array", "items": { "type": "string" } },
    "disclaimer": { "type": "string" }
  },
  "$defs": {
    "bot": {
      "type": "object",
      "required": ["bot_id", "bot_name", "bot_version", "owner", "maturity_group"],
      "properties": {
        "bot_id": { "type": "string" },
        "bot_name": { "type": "string" },
        "bot_version": { "type": "string" },
        "owner": { "type": "string" },
        "maturity_group": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["region", "target_date", "time_granularity", "location", "applicable_scenarios"],
      "properties": {
        "region": { "type": "string" },
        "target_date": { "type": "string" },
        "time_granularity": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "applicable_scenarios": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["name", "latitude", "longitude", "source"],
      "properties": {
        "name": { "type": "string" },
        "code": { "type": ["string", "null"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "source": { "type": "string" },
        "country": { "type": ["string", "null"] },
        "province": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "time_info": {
      "type": "object",
      "required": ["submit_time", "data_cutoff_time", "forecast_start", "forecast_end"],
      "properties": {
        "submit_time": { "type": "string" },
        "data_cutoff_time": { "type": "string" },
        "forecast_start": { "type": "string" },
        "forecast_end": { "type": "string" }
      },
      "additionalProperties": false
    },
    "data_profile": {
      "type": "object",
      "required": [
        "data_source_group",
        "data_sources_summary",
        "disclosure_level",
        "known_limitations",
        "provider_status"
      ],
      "properties": {
        "data_source_group": { "type": "string" },
        "data_sources_summary": { "type": "array", "items": { "type": "string" } },
        "disclosure_level": { "type": "string" },
        "known_limitations": { "type": "array", "items": { "type": "string" } },
        "provider_status": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "forecast_point": {
      "type": "object",
      "required": ["time"],
      "properties": {
        "time": { "type": "string" },
        "temperature": { "type": ["number", "null"] },
        "precipitation_probability": { "type": ["number", "null"] },
        "wind_speed": { "type": ["number", "null"] },
        "cloud_cover": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["unit", "values", "summary"],
      "properties": {
        "unit": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "values": { "type": "array", "items": { "$ref": "#/$defs/forecast_point" } },
        "summary": { "$ref": "#/$defs/forecast_summary" }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["key_factors", "risk_notes", "business_readable_summary"],
      "properties": {
        "key_factors": { "type": "array", "items": { "type": "string" } },
        "risk_notes": { "type": "array", "items": { "type": "string" } },
        "business_readable_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scoring_profile": {
      "type": "object",
      "required": [
        "participate_in_public_scorecard",
        "preferred_group",
        "self_declared_strengths",
        "not_suitable_for"
      ],
      "properties": {
        "participate_in_public_scorecard": { "type": "boolean" },
        "preferred_group": { "type": "string" },
        "self_declared_strengths": { "type": "array", "items": { "type": "string" } },
        "not_suitable_for": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "provider_forecast": {
      "type": "object",
      "required": ["provider", "status", "points"],
      "properties": {
        "provider": { "type": "string" },
        "status": { "enum": ["ok", "disabled", "error"] },
        "points": { "type": "array", "items": { "$ref": "#/$defs/forecast_point" } },
        "error_message": { "type": ["string", "null"] },
        "raw": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "forecast_summary": {
      "type": "object",
      "required": ["main_weather", "high_risk_period"],
      "properties": {
        "max_temperature": { "type": ["number", "null"] },
        "min_temperature": { "type": ["number", "null"] },
        "rain_probability": { "type": ["number", "null"] },
        "wind_speed": { "type": ["number", "null"] },
        "cloud_cover": { "type": ["number", "null"] },
        "main_weather": { "type": "string" },
        "high_risk_period": { "type": "string" }
      },
      "additionalProperties": false
    },
    "aggregated_forecast": {
      "type": "object",
      "required": ["providers_used", "points", "summary"],
      "properties": {
        "providers_used": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "array", "items": { "$ref": "#/$defs/forecast_point" } },
        "summary": { "$ref": "#/$defs/forecast_summary" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
